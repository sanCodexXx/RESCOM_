PORT=5000
NODE_ENV=development

# --- Database ----------------------------------------------------------
# Local: fill in the DB_* values.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mdrrmo_db
DB_PASSWORD=
DB_PORT=5432
# Hosted (Neon / Supabase / Render / Azure): paste the single connection
# string instead. When DATABASE_URL is set, the DB_* values are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth --------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- CORS ---------------------------------------------------------------
# Your frontend URL(s), comma-separated, NO trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# --- Sign-up policy ----------------------------------------------------
# The first account created is always Admin Staff. Set to false in
# production so only admins can create further accounts (Users page).
ALLOW_PUBLIC_REGISTRATION=true

# --- Uploaded center photos --------------------------------------------
# Leave blank locally. On a host with a persistent disk, point this to it
# (e.g. /var/data/uploads) so photos survive redeploys.
UPLOAD_DIR=

# --- Forgot-password PIN delivery ---------------------------------------
# OPTION A (use on Render's free tier - it blocks SMTP ports):
# Brevo HTTPS API. Free account; verify a sender address in Brevo, then:
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=RESCOM
#
# OPTION B (local machine or a VPS): Gmail SMTP.
# Use a 16-char Google App Password (no spaces), not your normal password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RESCOM <your_gmail_address@gmail.com>"

# SMS gateway (optional)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=RESCOM
